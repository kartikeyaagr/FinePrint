{
  "manifest_version": 3,
  "name": "Term Reader",
  "description": "Understand Terms & Conditions before you agree. LLM-powered plain-English summaries with security ratings.",
  "version": "0.1.0",
  "icons": {
    "16": "public/icons/icon-16.png",
    "32": "public/icons/icon-32.png",
    "48": "public/icons/icon-48.png",
    "128": "public/icons/icon-128.png"
  },
  "permissions": [
    "activeTab",
    "storage",
    "tabs"
  ],
  "background": {
    "service_worker": "src/background/service-worker.ts",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "src/content/content.ts"
      ],
      "css": [],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Term Reader",
    "default_popup": "src/ui/sidepanel/index.html"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}